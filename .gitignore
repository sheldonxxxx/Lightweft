# Public source allowlist. Everything else stays local, including photos,
# manifests, editing runs, credentials, and the independent RapidRAW checkout.
*

# Repository documentation and validation.
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/LICENSE
!/.github/
!/.github/workflows/
!/.github/workflows/validate.yml
!/assets/
!/assets/readme-hero.svg
!/scripts/
!/scripts/check_public_repo.py

# Shared planning and personal-style skills.
!/skills/
!/skills/photo-edit-master/
!/skills/photo-edit-master/SKILL.md
!/skills/photo-edit-master/references/
!/skills/photo-edit-master/references/*.md
!/skills/photo-style-builder/
!/skills/photo-style-builder/SKILL.md

# Collection workflow and synthetic tests.
!/workflow/
!/workflow/README.md
!/workflow/build_suite.py
!/workflow/build_catalogue.py
!/workflow/verify_collection.py
!/workflow/catalogue.css
!/workflow/selection.example.json
!/workflow/evaluation-template.json
!/tests/
!/tests/test_workflow.py
!/tests/test_review.py
!/tests/test_review_import.py

# Shared review application and browser modules.
!/review/
!/review/README.md
!/review/server.py
!/review/cli.py
!/review/import_legacy.py
!/review/package.json
!/review/web/
!/review/web/*.html
!/review/web/*.js
!/review/web/*.css
!/review/web/*.svg
!/review/web/panels/
!/review/web/panels/*.js
!/review/tests/
!/review/tests/fixture.py
!/review/tests/store.test.mjs

!/review/tests/sphere.test.mjs

# Approved public showcase and its validation tools.
!/.github/workflows/pages.yml
!/scripts/build_showcase.py
!/scripts/showcase_media.py
!/tests/test_showcase.py
!/showcase/
!/showcase/README.md
!/showcase/LICENSE
!/showcase/index.html
!/showcase/styles.css
!/showcase/app.js
!/showcase/data.json
!/showcase/assets/
!/showcase/assets/**/
!/showcase/assets/**/*.jpg
